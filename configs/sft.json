{
  "data": {
    "path": "datasets",
    "train_split": "train",
    "validation_split": "validation",
    "max_examples": null,
    "max_validation_examples": null
  },
  "model": {
    "name": "microsoft/phi-2",
    "device": "auto",
    "dtype": "auto",
    "lora": {
      "r": 16,
      "lora_alpha": 16,
      "lora_dropout": 0.05,
      "target_modules": [
        "q_proj",
        "k_proj",
        "v_proj",
        "dense"
      ]
    }
  },
  "training": {
    "output_dir": "checkpoints/sft",
    "seed": 10,
    "batch_size": 1,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.0002,
    "epochs": 8,
    "max_steps": null,
    "max_length": 512,
    "max_grad_norm": 1.0,
    "gradient_checkpointing": true,
    "logging_steps": 10
  }
}
